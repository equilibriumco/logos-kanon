target/

# Rendered reports. Matched by extension rather than by name so a stray output name
# cannot slip in.
*.pdf

# Exception: the M0 report is a delivered artifact, not a build output.
!m0/M0-report.pdf

# Python bytecode, from running the capture script by hand.
__pycache__/

# Editor scratch.
.code_marks/

# `lgs setup` materialises circuits, a wallet and its state here. Build output of a
# toolchain run, not project state; `scaffold.toml` is the part that is committed.
.scaffold/
